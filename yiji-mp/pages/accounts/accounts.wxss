.acc-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f3f3f3;
}
.acc-row:last-child { border-bottom: none; }
.acc-icon { font-size: 44rpx; margin-right: 20rpx; }
.acc-mid { flex: 1; display: flex; flex-direction: column; }
.acc-name { font-size: 30rpx; color: #222; }
.acc-sub { font-size: 24rpx; margin-top: 4rpx; }
.acc-del { color: #e54d42; font-size: 26rpx; padding: 8rpx 16rpx; }

.add-btn {
  margin: 24rpx 32rpx;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.sheet {
  background: #fff;
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
}
.sheet-title { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.field-label { width: 140rpx; color: #999; font-size: 28rpx; }
.note-input { flex: 1; font-size: 30rpx; }

.icon-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 0;
}
.icon-cell {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  border-radius: 16rpx;
  margin: 8rpx;
  background: #f5f5f5;
}
.icon-cell.on { background: #d8efe1; border: 2rpx solid #2f7d4f; }

.sheet-btns { display: flex; margin-top: 16rpx; }
.sheet-btn {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.sheet-btn.ghost { background: #f0f0f0; color: #666; margin-right: 16rpx; }
.sheet-btn.primary { background: #2f7d4f; color: #fff; }
