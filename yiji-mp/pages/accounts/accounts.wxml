<view class="card">
  <view wx:for="{{accounts}}" wx:key="id" class="acc-row">
    <text class="acc-icon">{{item.icon}}</text>
    <view class="acc-mid">
      <text class="acc-name">{{item.name}}</text>
      <text class="acc-sub c-muted">初始 {{item.initial}} · 当前 {{item.balance}}</text>
    </view>
    <text class="acc-del" data-id="{{item.id}}" bindtap="del">删除</text>
  </view>
  <view wx:if="{{accounts.length === 0}}" class="empty">还没有账户</view>
</view>

<view class="add-btn btn-primary" bindtap="openAdd">+ 添加账户</view>

<view wx:if="{{showForm}}" class="mask" bindtap="closeForm">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">添加账户</view>
    <view class="field">
      <text class="field-label">名称</text>
      <input class="note-input" placeholder="如 招商银行" value="{{name}}" bindinput="onName" />
    </view>
    <view class="field">
      <text class="field-label">初始余额</text>
      <input class="note-input" type="digit" placeholder="0.00" value="{{initial}}" bindinput="onInitial" />
    </view>
    <view class="icon-grid">
      <text
        wx:for="{{icons}}"
        wx:key="*this"
        wx:for-index="i"
        class="icon-cell {{iconIndex === i ? 'on' : ''}}"
        data-i="{{i}}"
        bindtap="pickIcon"
      >{{item}}</text>
    </view>
    <view class="sheet-btns">
      <view class="sheet-btn ghost" bindtap="closeForm">取消</view>
      <view class="sheet-btn primary" bindtap="save">保存</view>
    </view>
  </view>
</view>
