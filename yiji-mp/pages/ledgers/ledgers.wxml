<view class="page">
  <view class="tip">当前使用的账本已高亮，点击即可切换。删除会一并清除账本内全部数据。</view>

  <view class="list">
    <view class="lg-row {{item.cur?'cur':''}}" wx:for="{{ledgers}}" wx:key="id" data-id="{{item.id}}" bindtap="switchLedger">
      <text class="lg-icon">{{item.icon}}</text>
      <view class="lg-main">
        <text class="lg-name">{{item.name}}</text>
        <text class="lg-count">{{item.count}} 笔记录</text>
      </view>
      <view class="lg-ops">
        <text class="lg-op" data-id="{{item.id}}" catchtap="rename">改名</text>
        <text class="lg-op del" data-id="{{item.id}}" catchtap="del">删除</text>
      </view>
      <text wx:if="{{item.cur}}" class="lg-badge">使用中</text>
    </view>
  </view>

  <view class="fab" bindtap="openAdd">＋ 新建账本</view>

  <view wx:if="{{showForm}}" class="mask" bindtap="closeForm">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">新建账本</view>
      <view class="field">
        <text class="field-label">账本名称</text>
        <input class="field-input" placeholder="如：家庭账本 / 旅行账本" value="{{name}}" bindinput="onName" />
      </view>
      <view class="hint">新建账本为空账本，账户与分类可在对应页面另行添加。</view>
      <view class="sheet-actions">
        <button class="btn ghost" bindtap="closeForm">取消</button>
        <button class="btn primary" bindtap="save">创建</button>
      </view>
    </view>
  </view>
</view>
