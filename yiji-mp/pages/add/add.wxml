<view class="type-bar">
  <view class="type-item {{type==='expense' ? 'on' : ''}}" data-type="expense" bindtap="switchType">支出</view>
  <view class="type-item {{type==='income' ? 'on' : ''}}" data-type="income" bindtap="switchType">收入</view>
</view>

<view class="card">
  <view class="amount-box">
    <text class="amount-symbol">¥</text>
    <input class="amount-input" type="digit" placeholder="0.00" value="{{amount}}" bindinput="onAmount" focus="{{true}}" />
  </view>

  <picker mode="selector" range="{{accounts}}" range-key="name" value="{{accountIndex}}" bindchange="onAccount">
    <view class="field">
      <text class="field-label">账户</text>
      <text class="field-value">{{accounts[accountIndex].icon}} {{accounts[accountIndex].name}}</text>
      <text class="field-arrow">›</text>
    </view>
  </picker>

  <picker mode="selector" range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="onCategory">
    <view class="field">
      <text class="field-label">分类</text>
      <text class="field-value">{{categories[categoryIndex].icon}} {{categories[categoryIndex].name}}</text>
      <text class="field-arrow">›</text>
    </view>
  </picker>

  <picker mode="date" value="{{date}}" bindchange="onDate">
    <view class="field">
      <text class="field-label">日期</text>
      <text class="field-value">{{date}}</text>
      <text class="field-arrow">›</text>
    </view>
  </picker>

  <view class="field">
    <text class="field-label">备注</text>
    <input class="note-input" placeholder="可选" value="{{note}}" bindinput="onNote" />
  </view>
</view>

<view class="save-btn btn-primary" bindtap="save">保存</view>
