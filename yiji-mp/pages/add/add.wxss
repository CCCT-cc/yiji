.type-bar {
  display: flex;
  background: #fff;
  margin: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.type-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #666;
}
.type-item.on {
  color: #fff;
  background: #2f7d4f;
  font-weight: 600;
}

.amount-box {
  display: flex;
  align-items: baseline;
  padding: 20rpx 0 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.amount-symbol { font-size: 44rpx; color: #2f7d4f; font-weight: 700; }
.amount-input {
  flex: 1;
  font-size: 64rpx;
  font-weight: 700;
  margin-left: 12rpx;
  color: #222;
}

.field {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.field-label { width: 120rpx; color: #999; font-size: 28rpx; }
.field-value { flex: 1; font-size: 30rpx; color: #222; }
.field-arrow { color: #ccc; font-size: 32rpx; }
.note-input { flex: 1; font-size: 30rpx; color: #222; }

.save-btn {
  margin: 32rpx 32rpx;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}
