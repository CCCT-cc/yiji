.profile {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #2f7d4f, #3a9a63);
  color: #fff;
  padding: 48rpx 40rpx;
}
.profile-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 24rpx;
}
.profile-name { font-size: 36rpx; font-weight: 700; }
.profile-sub { font-size: 24rpx; opacity: 0.9; }

.menu { margin-top: 16rpx; padding: 0 24rpx; }
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f3f3f3;
}
.menu-item:last-child { border-bottom: none; }
.mi-icon { font-size: 36rpx; margin-right: 20rpx; }
.mi-text { flex: 1; font-size: 30rpx; color: #333; }
.mi-arrow { color: #ccc; font-size: 32rpx; }
.menu-item.danger .mi-text { color: #e54d42; }

.tip {
  text-align: center;
  color: #aaa;
  font-size: 24rpx;
  padding: 32rpx 40rpx 60rpx;
  line-height: 1.6;
}
