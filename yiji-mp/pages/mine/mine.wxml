<view class="profile">
  <view class="profile-icon">📒</view>
  <view class="profile-info">
    <text class="profile-name">{{ledgerName}}</text>
    <text class="profile-sub c-muted">{{accountCount}} 个账户 · {{txCount}} 条记录</text>
  </view>
</view>

<view class="card menu">
  <view class="menu-item" bindtap="goLedgers">
    <text class="mi-icon">📚</text><text class="mi-text">账本管理</text><text class="mi-arrow">›</text>
  </view>
  <view class="menu-item" bindtap="goAccounts">
    <text class="mi-icon">💳</text><text class="mi-text">账户管理</text><text class="mi-arrow">›</text>
  </view>
  <view class="menu-item" bindtap="goCategories">
    <text class="mi-icon">🏷️</text><text class="mi-text">分类管理</text><text class="mi-arrow">›</text>
  </view>
</view>

<view class="card menu">
  <view class="menu-item" bindtap="exportBackup">
    <text class="mi-icon">📤</text><text class="mi-text">导出备份（CSV）</text><text class="mi-arrow">›</text>
  </view>
  <view class="menu-item" bindtap="about">
    <text class="mi-icon">ℹ️</text><text class="mi-text">关于</text><text class="mi-arrow">›</text>
  </view>
</view>

<view class="card menu">
  <view class="menu-item danger" bindtap="clearAll">
    <text class="mi-icon">🗑️</text><text class="mi-text">清空全部数据</text><text class="mi-arrow">›</text>
  </view>
</view>

<view class="tip">数据仅存于本机，卸载小程序会清除。重要数据请定期导出备份。</view>
