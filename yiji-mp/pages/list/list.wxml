<view wx:if="{{empty}}" class="empty">还没有记录，去记一笔吧</view>

<block wx:else>
  <view wx:for="{{groups}}" wx:key="date" wx:for-item="g" class="group">
    <view class="group-head">
      <text>{{g.dateLabel}}</text>
      <text class="c-muted">收 {{g.incomeLabel}} · 支 {{g.expenseLabel}}</text>
    </view>
    <view class="card list-card">
      <view
        wx:for="{{g.items}}"
        wx:key="id"
        wx:for-item="it"
        class="tx-row"
        data-id="{{it.id}}"
        bindlongpress="del"
      >
        <text class="tx-icon">{{it.icon}}</text>
        <view class="tx-mid">
          <text class="tx-cat">{{it.catName}}</text>
          <text class="tx-sub c-muted">{{it.accName}}{{it.note ? ' · ' + it.note : ''}}</text>
        </view>
        <text class="tx-amt {{it.cls}}">{{it.sign}}{{it.amount}}</text>
      </view>
    </view>
  </view>
  <view style="height:40rpx"></view>
</block>

<view class="fab" bindtap="goAdd">＋</view>
