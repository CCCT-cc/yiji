page {
  background: #f2f4f2;
  color: #222;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
}

.c-red { color: #e54d42; }
.c-green { color: #2f7d4f; }
.c-muted { color: #999; }

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #2f7d4f;
  color: #fff;
}
.btn-primary:active { opacity: 0.85; }

.btn-ghost {
  background: #fff;
  color: #2f7d4f;
  border: 1rpx solid #2f7d4f;
}

.row {
  display: flex;
  align-items: center;
}
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #2f7d4f;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  box-shadow: 0 8rpx 24rpx rgba(47, 125, 79, 0.4);
  z-index: 50;
}
.fab:active { opacity: 0.85; }

.empty {
  text-align: center;
  color: #bbb;
  padding: 120rpx 0;
  font-size: 26rpx;
}
