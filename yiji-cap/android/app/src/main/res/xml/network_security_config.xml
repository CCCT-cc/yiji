<?xml version="1.0" encoding="utf-8"?>
<!-- 一记安全策略：强制 HTTPS，禁止明文 HTTP 流量，降低中间人劫持风险 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
